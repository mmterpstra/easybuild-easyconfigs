	# Author: Jasper Grimm (UoY)

easyblock = 'ConfigureMake'

name = 'tabixpp'
version = '1.1.2'

homepage = 'https://github.com/ekg/tabixpp'
description = """C++ wrapper to tabix indexer"""

toolchain = {'name': 'GCC', 'version': '11.3.0'}

github_account = 'ekg'
source_urls = [GITHUB_SOURCE]
sources = ['v%(version)s.tar.gz']
#patches = ['%(name)s-1.1.0_use-external-HTSlib.patch']
checksums = [
    {'v1.1.2.tar.gz':
        'c850299c3c495221818a85c9205c60185c8ed9468d5ec2ed034470bb852229dc'},
#    {'tabixpp-1.1.0_use-external-HTSlib.patch':
#        '65496b6e042cf54290386a33cf0de26cb1160b3ddb35216765999d790b99cab4'},
]

dependencies = [
    ('zlib', '1.2.12'),
    ('bzip2', '1.0.8'),
    ('XZ', '5.2.5'),
    ('HTSlib', '1.16'),
    ('PCRE2', '10.40'),
]

skipsteps = ['configure']

local_opts = ' HTS_LIB=$EBROOTHTSLIB/lib/libhts.a HTS_HEADERS="$EBROOTHTSLIB/include/htslib/bgzf.h $EBROOTHTSLIB/include/htslib/tbx.h" SLIB=libtabixpp.so.1 LIB=libtabixpp.a'
buildopts =  local_opts
installopts = ' PREFIX=%(installdir)s DESTDIR=""' + local_opts 
postinstallcmds = ['ln -s %(installdir)s/lib/libtabixpp.' + SHLIB_EXT +
    '.1 %(installdir)s/lib/libtabixpp.' + SHLIB_EXT ]

sanity_check_paths = {
    'files': ['bin/tabix++', 'lib/libtabixpp.%s' % SHLIB_EXT],
    'dirs': [],
}

moduleclass = 'bio'
