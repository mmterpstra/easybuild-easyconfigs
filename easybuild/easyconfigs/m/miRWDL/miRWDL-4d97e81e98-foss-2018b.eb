easyblock = 'PackedBinary'

name = 'miRWDL'
version = '4d97e81e98'
local_versionlong = '4d97e81e98c448c40847c05a6241e802d4577a91'

homepage = 'https://github.com/mmterpstra/miRWDL'
description = """Scalable miRNA quantification workflow """

toolchain = {'name': 'foss', 'version': '2018b'}

#https://github.com/mmterpstra/miRWDL/archive/4d97e81e98c448c40847c05a6241e802d4577a91.tar.gz
source_urls = ['https://github.com/mmterpstra/miRWDL/archive/']
sources = [local_versionlong + '.tar.gz']
checksums = ['26d5ae47bc9c09c545350c6c84dfaf2a7d8c582935a20e4cc4665193bbd5c21d']

dependencies = [
    ('cromwell', '56', '-Java-11', True),
    ('FastQC', '0.11.9', '-Java-11', True),
    ('miRDeep2', '0.1.1', '-Python-3.6.6'),
    ('Trim_Galore', '0.6.2', '-Python-3.6.6'),
    ('MultiQC', '1.7', '-Python-3.6.6')
]

install_cmd = "cp -a */* %(installdir)s"

sanity_check_paths = {
    'files': ['miR.wdl'],
    'dirs': ['tasks'],
}

moduleclass = 'bio'
