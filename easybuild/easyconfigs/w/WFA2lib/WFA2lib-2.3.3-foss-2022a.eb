# Author: Jasper Grimm (UoY)
# Updated: Denis Kristak (INUITS)
easyblock = 'CMakeMake'

name = 'WFA2lib'
version = '2.3.3'

homepage = 'https://github.com/smarco/WFA2-lib'
description = """ WFA2-lib: Wavefront alignment algorithm library v2."""
toolchain = {'name': 'foss', 'version': '2022a'}

source_urls = ['https://github.com/smarco/WFA2-lib/archive/refs/tags/']
sources = ['v%(version)s.tar.gz']
checksums = [ "2569650cdba395f42513a4d2c9175724a736047bb7da99a162c0abdbd651698f" ]

builddependencies = [
    ('binutils', '2.38'),
    ('CMake', '3.23.1'),
    ('pkg-config', '0.29.2'),
]

dependencies = [
    ("PythonPlus","3.10.4", "-v23.01.1"),
    ("Rust", "1.60.0")
]

modextrapaths = {'PATH': ['scripts'],
    'INCLUDEPATH': ['include/wfa2lib'],
    'CPATH': ['include/wfa2lib'],}

sanity_check_paths = {
    'files': ['include/wfa2lib/wavefront/wavefront_align.h'],
    'dirs': ['include/wfa2lib/wavefront/'],
}

moduleclass = 'bio'
