#postinstallcmds = ["ls $PWD %(installdir)s %(builddir)s && printenv | grep 'EBROOT\|ichorCNA' && exit 1 &&
postinstallcmds = [
    'sed -i.old "1s;^;#!/usr/bin/env Rscript\\n;" %(builddir)s/ichorCNA/ichorCNA-5bfc03ed854f0e93fe5b624c97c1290fa0053837/scripts/*.R',
    'chmod 775 %(builddir)s/ichorCNA/ichorCNA-5bfc03ed854f0e93fe5b624c97c1290fa0053837/scripts/*.R',
    'mkdir -p %(installdir)s/ichorCNA/bin',
    'cp -rv %(builddir)s/ichorCNA/ichorCNA-5bfc03ed854f0e93fe5b624c97c1290fa0053837/scripts/* %(installdir)s/ichorCNA/bin/'
]
