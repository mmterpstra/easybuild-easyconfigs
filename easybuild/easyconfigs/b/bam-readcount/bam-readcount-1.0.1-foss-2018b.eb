# This file is an EasyBuild reciPY as per https://github.com/easybuilders/easybuild
# Author: Adam Huffman
# The Francis Crick Institute
easyblock = 'CMakeMake'

name = 'bam-readcount'
version = '1.0.1'

homepage = 'https://github.com/genome/bam-readcount'
description = "Count DNA sequence reads in BAM files"

toolchain = {'name': 'foss', 'version': '2018b'}

source_urls = ['https://github.com/genome/%(name)s/archive']
sources = ['v%(version)s.tar.gz']
checksums = ['8ebf84d9efee0f2d3b43f0452dbf16b27337c960e25128f6a7173119e62588b8']

builddependencies = [
    ('CMake', '3.12.1'),
]
dependencies = [
    ('SAMtools', '1.10'),
    ('HTSlib', '1.10.2'),
    ('zlib', '1.2.11'),
    ('ncurses', '6.1'),
    ('Boost', '1.67.0'),
    ('XZ','5.2.5'),
]

parallel = 1


local_commit = '944c11f'
local_versionfile = '%(builddir)s/%(name)s*/version/version.h.in'
preconfigopts = "sed -i -e 's/@FULL_VERSION@/%%(version)s/' %s && " % local_versionfile
preconfigopts += "sed -i -e 's/@COMMIT_HASH@/%s/' %s && " % (local_commit, local_versionfile)

preconfigopts += "perl -i.bak -wpe 's/-Wall -std=c\+\+0x/-Wall -std=c++0x -lhts -lbam -fPIC  -lhts -L\$EBROOTHTSLIB\/lib\/ -lbam -L\$EBROOTSAMTOOLS\/lib /' %(builddir)s/%(name)s*/CMakeLists.txt && "
#include(BuildSamtools)
preconfigopts += "perl -i -wpe 's/include\(BuildSamtools\)/#include(BuildSamtools)/' %(builddir)s/%(name)s*/CMakeLists.txt && "
#preconfigopts += "perl -i -wpe 's/include\(BuildBoost\)/#include(BuildBoost)/' %(builddir)s/%(name)s*/CMakeLists.txt && "
preconfigopts += "export LDFLAGS='-lcurl -lhts -lbam -lz -llzma -lssl -lcrypto -lbz2' && export CPATH=${EBROOTSAMTOOLS}/include/bam:${EBROOTHTSLIB}/include/htslib:%(builddir)s/easybuid_obj/vendor/samtools*/htslib*:$CPATH && "
configopts = " -DCMAKE_CXX_FLAGS='-Wall -std=c++0x -fPIC  -lhts -L$EBROOTHTSLIB/lib/ -lbam -L$EBROOTSAMTOOLS/lib '  -DSamtools_LIBRARIES='-lhts -L$EBROOTHTSLIB/lib/ -lbam -L$EBROOTSAMTOOLS/lib' -DSamtools_INCLUDE_DIRS='${EBROOTSAMTOOLS}/include/' -DHtslib_INCLUDE_DIRS='%(builddir)s/easybuild_obj/vendor/samtools-1.10/htslib-1.10' "

prebuildopts = "export SAMTOOLS_ROOT=${EBROOTSAMTOOLS}/include/bam && "
prebuildopts += "(cd %(builddir)s/easybuild_obj/vendor/ && tar -jxf  %(builddir)s/%(name)s*/vendor/samtools-1.10.tar.bz2 )&& "
prebuildopts += "export CPATH=${EBROOTSAMTOOLS}/include/bam:${EBROOTHTSLIB}/include/htslib:$CPATH && "

#buildopts = "-j 1 Samtools_LIBRARIES=' -lhts -L$EBROOTHTSLIB/lib/ -lbam -L$EBROOTSAMTOOLS/lib '"

sanity_check_paths = {
    'files': ['bin/%(name)s'],
    'dirs': [],
}

sanity_check_commands = [
    # --help exists with exit code 1, so use grep to check for expected pattern in help output
    "%(name)s --help 2>&1 | grep 'Example: %(name)s -f'",
    "%(name)s --version | grep 'version: %(version)s '",
]

moduleclass = 'bio'
